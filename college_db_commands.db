UPDATE OPERATIONS:

1. Update student mobile using $set:
db.students.updateOne(
  { studentId: 101 },
  { $set: { mobile: "9999999999" } }
)

2. Modify admission status:
db.admissions.updateOne(
  { applicationId: 1 },
  { $set: { status: "approved" } }
)


3. Add new skill using $push:
db.career_requests.updateOne(
  { requestId: 1 },
  { $push: { skills: "CSS" } }
)


4. Remove skill using $pull:
db.career_requests.updateOne(
  { requestId: 1 },
  { $pull: { skills: "HTML" } }
)


5. Prevent duplicate using $addToSet:
db.career_requests.updateOne(
  { requestId: 1 },
  { $addToSet: { skills: "JavaScript" } }
)


6. Update event status:
db.events.updateOne(
  { eventId: "E1" },
  { $set: { status: "completed" } }
)


7. replaceOne:
db.notices.replaceOne(
  { noticeId: 5 },
  {
    noticeId: 5,
    title: "Updated Notice",
    content: "Notice content updated fully",
    publishedDate: ISODate(),
    isActive: true
  }
)
